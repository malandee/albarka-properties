# Copy to .env and replace the placeholders. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/albarka?schema=public"
APP_URL="http://localhost:3000"
MEDIA_DIR="./storage/media"
SESSION_MAX_HOURS=12
SESSION_IDLE_MINUTES=120
TRUST_PROXY=false
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="AlbarkaProperties/1.0 (contact@example.com)"
